{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.49.2.45890",
      "templateHash": "3922860593751513900"
    },
    "description": "Unofficial Sophos Fusion Data Exporter: a scheduled Azure Container Apps job that writes the CSV star schema to an Azure Files share and uploads it to SharePoint for Power BI. Not a Sophos product."
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for every resource. Pick the one nearest the Sophos tenant's data region, for example Australia East for an api-au01 tenant. The CSV files are stored here."
      }
    },
    "namePrefix": {
      "type": "string",
      "defaultValue": "fusion-export",
      "minLength": 3,
      "maxLength": 20,
      "metadata": {
        "description": "Prefix for resource names. Lowercase letters, digits and hyphens."
      }
    },
    "image": {
      "type": "string",
      "defaultValue": "ghcr.io/aaronjacobs000/sophos-fusion-export:0.1.0",
      "metadata": {
        "description": "Container image. The default is the public image built from the GitHub repository. For your own build, use <registry>.azurecr.io/sophos-fusion-export:<tag> and set registryName."
      }
    },
    "registryName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional. An Azure Container Registry in this resource group to pull the image from with the managed identity. Leave empty for a public image."
      }
    },
    "sophosClientId": {
      "type": "securestring",
      "metadata": {
        "description": "Sophos Fusion tenant API credential: the client ID. Stored in Key Vault."
      }
    },
    "sophosClientSecret": {
      "type": "securestring",
      "metadata": {
        "description": "Sophos Fusion tenant API credential: the client secret. Stored in Key Vault."
      }
    },
    "reportTimezone": {
      "type": "string",
      "defaultValue": "UTC",
      "metadata": {
        "description": "IANA time zone for the *_local_date columns, for example Australia/Sydney. Set the Power BI refresh time zone to match."
      }
    },
    "tenantName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional. Tenant name shown in dim_tenant. Empty means the name Sophos reports."
      }
    },
    "personalData": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Export hostnames, users, case titles and descriptions. Off by default; read the Personal data section of the README first."
      }
    },
    "sharePointSiteUrl": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional. SharePoint site or OneDrive URL to upload the CSV files to, for example https://contoso.sharepoint.com/sites/reporting. The managed identity needs Sites.Selected with write on it (docs/azure.md). Empty means no upload."
      }
    },
    "sharePointLibrary": {
      "type": "string",
      "defaultValue": "Documents",
      "metadata": {
        "description": "Document library on the SharePoint site."
      }
    },
    "sharePointFolder": {
      "type": "string",
      "defaultValue": "FusionExport",
      "metadata": {
        "description": "Folder in the library for the CSV files."
      }
    },
    "cronExpression": {
      "type": "string",
      "defaultValue": "17 0,6,12,18 * * *",
      "metadata": {
        "description": "When the scheduled job runs, as a cron expression in UTC. The default runs four times a day at 00:17, 06:17, 12:17 and 18:17 UTC."
      }
    },
    "memoryGiB": {
      "type": "int",
      "defaultValue": 4,
      "allowedValues": [
        4,
        8
      ],
      "metadata": {
        "description": "Memory for each run, in GiB. 4 fits a tenant with a few hundred thousand rows of history; 8 doubles the CPU and the compute cost."
      }
    },
    "mountOptions": {
      "type": "string",
      "defaultValue": "uid=1000,gid=1000,dir_mode=0700,file_mode=0600",
      "metadata": {
        "description": "Mount options for the Azure Files share. The defaults make the container's node user (uid 1000) the owner."
      }
    }
  },
  "variables": {
    "suffix": "[uniqueString(resourceGroup().id, parameters('namePrefix'))]",
    "exportMountPath": "/data",
    "shareName": "export",
    "cpuCores": "[div(parameters('memoryGiB'), 2)]",
    "heapMb": "[mul(parameters('memoryGiB'), 768)]",
    "keyVaultSecretsUserRole": "4633458b-17de-408a-b874-0445c86b69e6",
    "acrPullRole": "7f951dda-4ed3-4680-a7ca-43fe172d538d",
    "useRegistry": "[not(empty(parameters('registryName')))]",
    "exporterConfig": "[union(createObject('reportTimezone', parameters('reportTimezone'), 'personalData', parameters('personalData')), if(empty(parameters('tenantName')), createObject(), createObject('tenantName', parameters('tenantName'))), if(empty(parameters('sharePointSiteUrl')), createObject(), createObject('sharepoint', createObject('siteUrl', parameters('sharePointSiteUrl'), 'library', parameters('sharePointLibrary'), 'folder', parameters('sharePointFolder'), 'auth', 'managedIdentity'))))]",
    "registries": "[if(variables('useRegistry'), createArray(createObject('server', format('{0}{1}', parameters('registryName'), environment().suffixes.acrLoginServer), 'identity', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('namePrefix'))))), createArray())]",
    "jobs": [
      {
        "name": "[parameters('namePrefix')]",
        "triggerType": "Schedule",
        "command": "run",
        "replicaTimeout": 1800
      },
      {
        "name": "[format('{0}-backfill', parameters('namePrefix'))]",
        "triggerType": "Manual",
        "command": "backfill",
        "replicaTimeout": 3600
      }
    ]
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2025-02-01",
      "name": "[format('{0}-logs', parameters('namePrefix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30,
        "workspaceCapping": {
          "dailyQuotaGb": "[json('0.1')]"
        }
      }
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2024-11-30",
      "name": "[format('{0}-identity', parameters('namePrefix'))]",
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2025-05-01",
      "name": "[format('kv{0}', variables('suffix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2025-05-01",
      "name": "[format('{0}/{1}', format('kv{0}', variables('suffix')), 'sophos-client-id')]",
      "properties": {
        "value": "[parameters('sophosClientId')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', format('kv{0}', variables('suffix')))]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2025-05-01",
      "name": "[format('{0}/{1}', format('kv{0}', variables('suffix')), 'sophos-client-secret')]",
      "properties": {
        "value": "[parameters('sophosClientSecret')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', format('kv{0}', variables('suffix')))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', format('kv{0}', variables('suffix')))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', format('kv{0}', variables('suffix'))), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('namePrefix'))), variables('keyVaultSecretsUserRole'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('keyVaultSecretsUserRole'))]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('namePrefix'))), '2024-11-30').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('namePrefix')))]",
        "[resourceId('Microsoft.KeyVault/vaults', format('kv{0}', variables('suffix')))]"
      ]
    },
    {
      "condition": "[variables('useRegistry')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.ContainerRegistry/registries', if(variables('useRegistry'), parameters('registryName'), 'none'))]",
      "name": "[guid(resourceGroup().id, parameters('registryName'), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('namePrefix'))), variables('acrPullRole'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('acrPullRole'))]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('namePrefix'))), '2024-11-30').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('namePrefix')))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2025-01-01",
      "name": "[format('st{0}', variables('suffix'))]",
      "location": "[parameters('location')]",
      "kind": "StorageV2",
      "sku": {
        "name": "Standard_LRS"
      },
      "properties": {
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true,
        "allowBlobPublicAccess": false,
        "allowCrossTenantReplication": false,
        "allowSharedKeyAccess": true,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}/{1}', format('st{0}', variables('suffix')), 'default')]",
      "properties": {
        "shareDeleteRetentionPolicy": {
          "enabled": true,
          "days": 7
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', format('st{0}', variables('suffix')))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices/shares",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}/{1}/{2}', format('st{0}', variables('suffix')), 'default', variables('shareName'))]",
      "properties": {
        "shareQuota": 5,
        "enabledProtocols": "SMB",
        "accessTier": "TransactionOptimized"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/fileServices', format('st{0}', variables('suffix')), 'default')]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}-env', parameters('namePrefix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('namePrefix'))), '2025-02-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('namePrefix'))), '2025-02-01').primarySharedKey]"
          }
        },
        "workloadProfiles": [
          {
            "name": "Consumption",
            "workloadProfileType": "Consumption"
          }
        ],
        "zoneRedundant": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('namePrefix')))]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments/storages",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}/{1}', format('{0}-env', parameters('namePrefix')), variables('shareName'))]",
      "properties": {
        "azureFile": {
          "accountName": "[format('st{0}', variables('suffix'))]",
          "accountKey": "[listKeys(resourceId('Microsoft.Storage/storageAccounts', format('st{0}', variables('suffix'))), '2025-01-01').keys[0].value]",
          "shareName": "[variables('shareName')]",
          "accessMode": "ReadWrite"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('namePrefix')))]",
        "[resourceId('Microsoft.Storage/storageAccounts/fileServices/shares', format('st{0}', variables('suffix')), 'default', variables('shareName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', format('st{0}', variables('suffix')))]"
      ]
    },
    {
      "copy": {
        "name": "exportJobs",
        "count": "[length(variables('jobs'))]"
      },
      "type": "Microsoft.App/jobs",
      "apiVersion": "2025-01-01",
      "name": "[variables('jobs')[copyIndex()].name]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('namePrefix'))))]": {}
        }
      },
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('namePrefix')))]",
        "workloadProfileName": "Consumption",
        "configuration": {
          "triggerType": "[variables('jobs')[copyIndex()].triggerType]",
          "replicaTimeout": "[variables('jobs')[copyIndex()].replicaTimeout]",
          "replicaRetryLimit": 1,
          "scheduleTriggerConfig": "[if(equals(variables('jobs')[copyIndex()].triggerType, 'Schedule'), createObject('cronExpression', parameters('cronExpression'), 'parallelism', 1, 'replicaCompletionCount', 1), null())]",
          "manualTriggerConfig": "[if(equals(variables('jobs')[copyIndex()].triggerType, 'Manual'), createObject('parallelism', 1, 'replicaCompletionCount', 1), null())]",
          "registries": "[variables('registries')]"
        },
        "template": {
          "containers": [
            {
              "name": "exporter",
              "image": "[parameters('image')]",
              "args": [
                "[variables('jobs')[copyIndex()].command]",
                "--out",
                "[variables('exportMountPath')]"
              ],
              "env": [
                {
                  "name": "FUSION_EXPORT_CONFIG_JSON",
                  "value": "[string(variables('exporterConfig'))]"
                },
                {
                  "name": "SOPHOS_KEY_VAULT_URL",
                  "value": "[reference(resourceId('Microsoft.KeyVault/vaults', format('kv{0}', variables('suffix'))), '2025-05-01').vaultUri]"
                },
                {
                  "name": "AZURE_CLIENT_ID",
                  "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('namePrefix'))), '2024-11-30').clientId]"
                },
                {
                  "name": "NODE_OPTIONS",
                  "value": "[format('--max-old-space-size={0}', variables('heapMb'))]"
                }
              ],
              "resources": {
                "cpu": "[variables('cpuCores')]",
                "memory": "[format('{0}Gi', parameters('memoryGiB'))]"
              },
              "volumeMounts": [
                {
                  "volumeName": "export",
                  "mountPath": "[variables('exportMountPath')]"
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "export",
              "storageType": "AzureFile",
              "storageName": "[variables('shareName')]",
              "mountOptions": "[parameters('mountOptions')]"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('namePrefix')))]",
        "[resourceId('Microsoft.App/managedEnvironments/storages', format('{0}-env', parameters('namePrefix')), variables('shareName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('namePrefix')))]",
        "[extensionResourceId(resourceId('Microsoft.ContainerRegistry/registries', if(variables('useRegistry'), parameters('registryName'), 'none')), 'Microsoft.Authorization/roleAssignments', guid(resourceGroup().id, parameters('registryName'), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('namePrefix'))), variables('acrPullRole')))]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', format('kv{0}', variables('suffix')), 'sophos-client-id')]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', format('kv{0}', variables('suffix')), 'sophos-client-secret')]",
        "[resourceId('Microsoft.KeyVault/vaults', format('kv{0}', variables('suffix')))]",
        "[extensionResourceId(resourceId('Microsoft.KeyVault/vaults', format('kv{0}', variables('suffix'))), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.KeyVault/vaults', format('kv{0}', variables('suffix'))), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('namePrefix'))), variables('keyVaultSecretsUserRole')))]"
      ]
    }
  ],
  "outputs": {
    "jobName": {
      "type": "string",
      "metadata": {
        "description": "Name of the scheduled job."
      },
      "value": "[variables('jobs')[0].name]"
    },
    "backfillJobName": {
      "type": "string",
      "metadata": {
        "description": "Name of the manual job that runs the first load. Start it once after the SharePoint grant."
      },
      "value": "[variables('jobs')[1].name]"
    },
    "identityClientId": {
      "type": "string",
      "metadata": {
        "description": "Client ID (app ID) of the managed identity. Grant it Sites.Selected and write on the SharePoint site."
      },
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('namePrefix'))), '2024-11-30').clientId]"
    },
    "identityPrincipalId": {
      "type": "string",
      "metadata": {
        "description": "Object ID of the managed identity's service principal, for the Sites.Selected app role assignment."
      },
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('namePrefix'))), '2024-11-30').principalId]"
    },
    "keyVaultName": {
      "type": "string",
      "metadata": {
        "description": "Key Vault that holds the Sophos credential."
      },
      "value": "[format('kv{0}', variables('suffix'))]"
    },
    "storageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Storage account that holds the CSV folder in its export share."
      },
      "value": "[format('st{0}', variables('suffix'))]"
    },
    "logAnalyticsWorkspaceId": {
      "type": "string",
      "metadata": {
        "description": "Log Analytics workspace ID (customer ID) for the job logs."
      },
      "value": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('namePrefix'))), '2025-02-01').customerId]"
    }
  }
}