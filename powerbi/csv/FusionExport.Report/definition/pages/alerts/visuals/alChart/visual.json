{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "alChart",
  "position": {
    "x": 16,
    "y": 168,
    "z": 4000,
    "width": 824,
    "height": 248,
    "tabOrder": 4000
  },
  "visual": {
    "visualType": "columnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Date"
                    }
                  },
                  "Property": "Date"
                }
              },
              "queryRef": "Date.Date",
              "nativeQueryRef": "Date"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_alert"
                    }
                  },
                  "Property": "severity"
                }
              },
              "queryRef": "fact_alert.severity",
              "nativeQueryRef": "severity",
              "displayName": "Severity"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_alert"
                    }
                  },
                  "Property": "Alerts"
                }
              },
              "queryRef": "fact_alert.Alerts",
              "nativeQueryRef": "Alerts"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Alerts per day by severity'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
