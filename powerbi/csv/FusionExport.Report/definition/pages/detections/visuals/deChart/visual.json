{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "deChart",
  "position": {
    "x": 16,
    "y": 168,
    "z": 5000,
    "width": 1248,
    "height": 232,
    "tabOrder": 5000
  },
  "visual": {
    "visualType": "columnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Date"
                    }
                  },
                  "Property": "Date"
                }
              },
              "queryRef": "Date.Date",
              "nativeQueryRef": "Date"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_detection_daily"
                    }
                  },
                  "Property": "severity_band"
                }
              },
              "queryRef": "fact_detection_daily.severity_band",
              "nativeQueryRef": "severity_band",
              "displayName": "Severity"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_detection_daily"
                    }
                  },
                  "Property": "Total detections"
                }
              },
              "queryRef": "fact_detection_daily.Total detections",
              "nativeQueryRef": "Total detections"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Detections per day by severity'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
