          },
          {
            "name": "users_with_violations",
            "dataType": "int64",
            "sourceColumn": "users_with_violations",
            "summarizeBy": "sum",
            "description": "Users with at least one blocked, warned or modified activity.",
            "lineageTag": "55b762fe-adc4-4938-85b7-62feadc47938"
          },
          {
            "name": "users_unsanctioned",
            "dataType": "int64",
            "sourceColumn": "users_unsanctioned",
            "summarizeBy": "sum",
            "description": "Users of apps no policy covers.",
            "lineageTag": "c83a2e0a-b40f-4c00-883a-2e0ab40fbc00"
          }
        ],
        "partitions": [
          {
            "name": "fact_ai_defense_snapshot",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = FusionTable(\"fact_ai_defense_snapshot.csv\", {{\"tenant_id\", \"text\"}, {\"snapshot_date\", \"date\"}, {\"license_state\", \"text\"}, {\"license_type\", \"text\"}, {\"license_expiry_date\", \"date\"}, {\"grace_period_ends_at\", \"datetime\"}, {\"renewal_pending\", \"boolean\"}, {\"onboarding_status\", \"text\"}, {\"license_refreshed_at\", \"datetime\"}, {\"window_days\", \"integer\"}, {\"apps\", \"integer\"}, {\"apps_critical\", \"integer\"}, {\"apps_high\", \"integer\"}, {\"apps_medium\", \"integer\"}, {\"apps_low\", \"integer\"}, {\"apps_info\", \"integer\"}, {\"apps_unknown\", \"integer\"}, {\"apps_error\", \"integer\"}, {\"apps_train_on_data\", \"integer\"}, {\"apps_unsanctioned\", \"integer\"}, {\"users\", \"integer\"}, {\"users_critical\", \"integer\"}, {\"users_high\", \"integer\"}, {\"users_medium\", \"integer\"}, {\"users_low\", \"integer\"}, {\"users_info\", \"integer\"}, {\"users_unknown\", \"integer\"}, {\"users_with_violations\", \"integer\"}, {\"users_unsanctioned\", \"integer\"}})",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "AI apps",
            "expression": "VAR LatestSnapshot = CALCULATE(MAX(fact_ai_defense_snapshot[snapshot_date]), ALLSELECTED(fact_ai_defense_snapshot))\nRETURN CALCULATE(SUM(fact_ai_defense_snapshot[apps]), fact_ai_defense_snapshot[snapshot_date] = LatestSnapshot) + 0",
            "formatString": "0",
            "description": "AI applications in the inventory window, latest snapshot, as Sophos counts them.",
            "lineageTag": "9ed5a810-cf0e-4d76-8ed5-a810cf0e0d76"
          },
          {
            "name": "AI users",
            "expression": "VAR LatestSnapshot = CALCULATE(MAX(fact_ai_defense_snapshot[snapshot_date]), ALLSELECTED(fact_ai_defense_snapshot))\nRETURN CALCULATE(SUM(fact_ai_defense_snapshot[users]), fact_ai_defense_snapshot[snapshot_date] = LatestSnapshot) + 0",
            "formatString": "0",
            "description": "Users of AI applications in the inventory window, latest snapshot, as Sophos counts them.",
            "lineageTag": "50c33848-1e80-403a-80c3-38481e80403a"
          }
        ]
      },
