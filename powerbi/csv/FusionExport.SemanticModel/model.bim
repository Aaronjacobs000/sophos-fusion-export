            "name": "Mean health check score",
            "expression": "VAR LatestSnapshot = MAX(fact_health_check_snapshot[snapshot_date])\nRETURN CALCULATE(AVERAGE(fact_health_check_snapshot[score]), fact_health_check_snapshot[snapshot_date] = LatestSnapshot)",
            "formatString": "0",
            "description": "Mean Account Health Check score, latest snapshot.",
            "lineageTag": "75ecf371-5fae-4967-85ec-f3715fae0967"
          }
        ]
      },
