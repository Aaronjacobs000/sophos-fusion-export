          {
            "name": "platform",
            "dataType": "string",
            "sourceColumn": "platform",
            "summarizeBy": "none",
            "description": "fusion when the tenant answers Sophos Fusion Cases v2, classic when it is still on cases v1.",
            "lineageTag": "294485df-db3d-4545-8944-85dfdb3d4545"
          },
          {
            "name": "report_timezone",
            "dataType": "string",
            "sourceColumn": "report_timezone",
            "summarizeBy": "none",
            "description": "IANA time zone the *_local_date columns use.",
            "lineageTag": "08905004-873e-4262-8890-5004873e5262"
          },
          {
            "name": "license_codes",
            "dataType": "string",
            "sourceColumn": "license_codes",
            "summarizeBy": "none",
            "description": "License codes the tenant holds, joined with |.",
            "lineageTag": "60a5ac3a-0fe8-470c-80a5-ac3a0fe8b70c"
          },
          {
            "name": "exported_at",
            "dataType": "dateTime",
            "sourceColumn": "exported_at",
            "formatString": "yyyy-mm-dd hh:nn:ss",
            "summarizeBy": "none",
            "description": "When this row was last written.",
            "lineageTag": "a20a1a99-0735-4707-820a-1a9907358707"
          }
        ],
        "partitions": [
          {
            "name": "dim_tenant",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = FusionTable(\"dim_tenant.csv\", {{\"tenant_id\", \"text\"}, {\"tenant_name\", \"text\"}, {\"fusion_tenant_id\", \"text\"}, {\"partner_id\", \"text\"}, {\"organization_id\", \"text\"}, {\"data_region\", \"text\"}, {\"platform\", \"text\"}, {\"report_timezone\", \"text\"}, {\"license_codes\", \"text\"}, {\"exported_at\", \"datetime\"}})",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": []
      },
      {
        "name": "fact_license",
        "description": "Licenses held by the tenant, one snapshot a day.",
