          {
            "name": "fact_ai_user_snapshot",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = FusionTable(\"fact_ai_user_snapshot.csv\", {{\"tenant_id\", \"text\"}, {\"snapshot_date\", \"date\"}, {\"user_key\", \"text\"}, {\"user_id\", \"text\"}, {\"user_name\", \"text\"}, {\"risk\", \"text\"}, {\"risk_rank\", \"integer\"}, {\"apps_used\", \"integer\"}, {\"activities\", \"integer\"}, {\"policy_violations\", \"integer\"}, {\"unsanctioned_activities\", \"integer\"}, {\"top_app_id\", \"text\"}, {\"top_app_name\", \"text\"}, {\"first_seen_at\", \"datetime\"}, {\"last_seen_at\", \"datetime\"}, {\"window_days\", \"integer\"}})",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "User AI activities",
            "expression": "VAR LatestSnapshot = CALCULATE(MAX(fact_ai_user_snapshot[snapshot_date]), ALLSELECTED(fact_ai_user_snapshot))\nRETURN CALCULATE(SUM(fact_ai_user_snapshot[activities]), fact_ai_user_snapshot[snapshot_date] = LatestSnapshot)",
            "formatString": "#,0",
            "description": "The user's activities in the inventory window, latest snapshot.",
            "lineageTag": "cf72eeb3-b93b-4dad-8f72-eeb3b93b5dad"
          },
          {
            "name": "User policy violations",
            "expression": "VAR LatestSnapshot = CALCULATE(MAX(fact_ai_user_snapshot[snapshot_date]), ALLSELECTED(fact_ai_user_snapshot))\nRETURN CALCULATE(SUM(fact_ai_user_snapshot[policy_violations]), fact_ai_user_snapshot[snapshot_date] = LatestSnapshot)",
            "formatString": "#,0",
            "description": "The user's blocked, warned or modified activities in the inventory window, latest snapshot.",
            "lineageTag": "6465c156-6d21-4d98-8465-c1566d210d98"
          }
        ]
      },
