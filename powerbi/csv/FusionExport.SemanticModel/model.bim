          }
        ],
        "partitions": [
          {
            "name": "fact_endpoint_snapshot",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = FusionTable(\"fact_endpoint_snapshot.csv\", {{\"tenant_id\", \"text\"}, {\"snapshot_date\", \"date\"}, {\"endpoint_id\", \"text\"}, {\"endpoint_type\", \"text\"}, {\"hostname\", \"text\"}, {\"os_platform\", \"text\"}, {\"os_name\", \"text\"}, {\"os_build\", \"text\"}, {\"health_overall\", \"text\"}, {\"health_threats\", \"text\"}, {\"health_services\", \"text\"}, {\"last_seen_at\", \"datetime\"}, {\"days_since_seen\", \"number\"}, {\"online\", \"boolean\"}, {\"tamper_protection_enabled\", \"boolean\"}, {\"tamper_protection_supported\", \"boolean\"}, {\"isolation_status\", \"text\"}, {\"lockdown_status\", \"text\"}, {\"group_name\", \"text\"}, {\"mdr_managed\", \"boolean\"}, {\"protection_package\", \"text\"}, {\"core_agent_version\", \"text\"}, {\"products\", \"text\"}, {\"ipv4_addresses\", \"text\"}, {\"associated_person\", \"text\"}})",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Endpoints",
            "expression": "VAR LatestSnapshot = MAX(fact_endpoint_snapshot[snapshot_date])\nRETURN CALCULATE(COUNTROWS(fact_endpoint_snapshot), fact_endpoint_snapshot[snapshot_date] = LatestSnapshot) + 0",
            "formatString": "0",
            "description": "Endpoints in the latest snapshot of the selected dates.",
            "lineageTag": "cc08888c-7816-491a-8c08-888c7816291a"
          },
          {
            "name": "Endpoints not in good health",
            "expression": "VAR LatestSnapshot = MAX(fact_endpoint_snapshot[snapshot_date])\nRETURN CALCULATE(COUNTROWS(fact_endpoint_snapshot), fact_endpoint_snapshot[snapshot_date] = LatestSnapshot, fact_endpoint_snapshot[health_overall] <> \"good\") + 0",
            "formatString": "0",
            "description": "Latest snapshot, overall health not good.",
            "lineageTag": "80e701e5-aeff-40c7-80e7-01e5aeff10c7"
          },
          {
            "name": "Endpoints not seen 7+ days",
            "expression": "VAR LatestSnapshot = MAX(fact_endpoint_snapshot[snapshot_date])\nRETURN CALCULATE(COUNTROWS(fact_endpoint_snapshot), fact_endpoint_snapshot[snapshot_date] = LatestSnapshot, fact_endpoint_snapshot[days_since_seen] >= 7) + 0",
            "formatString": "0",
            "description": "Latest snapshot, last seen a week or more before it.",
            "lineageTag": "0e89fab1-5219-423b-8e89-fab15219e23b"
          },
          {
            "name": "Tamper protection off",
            "expression": "VAR LatestSnapshot = MAX(fact_endpoint_snapshot[snapshot_date])\nRETURN CALCULATE(COUNTROWS(fact_endpoint_snapshot), fact_endpoint_snapshot[snapshot_date] = LatestSnapshot, fact_endpoint_snapshot[tamper_protection_enabled] == FALSE()) + 0",
            "formatString": "0",
            "description": "Latest snapshot, tamper protection off.",
            "lineageTag": "041cb867-8dd8-49f1-841c-b8678dd809f1"
          }
        ]
      },
      {
        "name": "fact_health_check_snapshot",
        "description": "Account Health Check scores, one snapshot a day per check.",
        "lineageTag": "b6ae33aa-04ea-49ac-86ae-33aa04eae9ac",
        "columns": [
          {
            "name": "tenant_id",
            "dataType": "string",
            "sourceColumn": "tenant_id",
            "summarizeBy": "none",
            "isHidden": false,
            "description": "Sophos Central tenant ID (a UUID).",
            "lineageTag": "e204b41c-afb2-4aea-8204-b41cafb24aea"
          },
          {
            "name": "snapshot_date",
            "dataType": "dateTime",
            "sourceColumn": "snapshot_date",
            "formatString": "yyyy-mm-dd",
            "summarizeBy": "none",
            "description": "Day of the snapshot in the report time zone.",
            "lineageTag": "c3ca79a9-a78b-4017-83ca-79a9a78b8017"
          },
          {
            "name": "area",
            "dataType": "string",
            "sourceColumn": "area",
            "summarizeBy": "none",
            "description": "protection, policy, exclusions or tamperProtection.",
            "lineageTag": "4eef4edd-baee-430f-8eef-4eddbaee030f"
          },
          {
            "name": "scope",
            "dataType": "string",
            "sourceColumn": "scope",
            "summarizeBy": "none",
            "description": "What the score covers, for example computer, server, policy.computer.threat-protection or global.",
            "lineageTag": "b0fd7628-89c0-4b0e-80fd-762889c0db0e"
          },
          {
            "name": "score",
            "dataType": "double",
            "sourceColumn": "score",
            "summarizeBy": "sum",
            "description": "Score, 0 to 100.",
            "lineageTag": "a4f8e616-121d-4870-84f8-e616121d0870"
          },
          {
            "name": "total",
            "dataType": "int64",
            "sourceColumn": "total",
            "summarizeBy": "sum",
            "description": "Items checked, when Sophos says.",
            "lineageTag": "5288bf3e-d5dd-43b8-8288-bf3ed5ddb3b8"
          },
          {
            "name": "issue_count",
            "dataType": "int64",
            "sourceColumn": "issue_count",
            "summarizeBy": "sum",
            "description": "Items failing the check (not fully protected, not on recommended settings, risky exclusions, tamper protection off).",
            "lineageTag": "0acbbcef-5f98-4b31-8acb-bcef5f98cb31"
          },
          {
            "name": "snoozed",
            "dataType": "boolean",
            "sourceColumn": "snoozed",
            "summarizeBy": "none",
            "description": "The check is snoozed.",
            "lineageTag": "9c78f076-6b24-4478-8c78-f0766b244478"
          }
        ],
        "partitions": [
          {
            "name": "fact_health_check_snapshot",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = FusionTable(\"fact_health_check_snapshot.csv\", {{\"tenant_id\", \"text\"}, {\"snapshot_date\", \"date\"}, {\"area\", \"text\"}, {\"scope\", \"text\"}, {\"score\", \"number\"}, {\"total\", \"integer\"}, {\"issue_count\", \"integer\"}, {\"snoozed\", \"boolean\"}})",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Mean health check score",
            "expression": "VAR LatestSnapshot = MAX(fact_health_check_snapshot[snapshot_date])\nRETURN CALCULATE(AVERAGE(fact_health_check_snapshot[score]), fact_health_check_snapshot[snapshot_date] = LatestSnapshot)",
            "formatString": "0",
            "description": "Mean Account Health Check score, latest snapshot.",
            "lineageTag": "75ecf371-5fae-4967-85ec-f3715fae0967"
          }
        ]
      },
      {
        "name": "fact_alert",
        "description": "Sophos Central product alerts (Common API), current state per alert. Useful for tenants without XDR or MDR. An alert leaves the API once acknowledged, but stays in this table.",
