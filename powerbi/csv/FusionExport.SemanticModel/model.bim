      {
        "name": "fact_detection_daily",
        "description": "Detection counts by day, severity band and detector. Kept after detection detail is pruned, so long trends survive Sophos's retention.",
        "lineageTag": "dada46e5-7674-45c3-8ada-46e5767495c3",
        "columns": [
          {
            "name": "tenant_id",
            "dataType": "string",
            "sourceColumn": "tenant_id",
            "summarizeBy": "none",
            "isHidden": false,
            "description": "Sophos Central tenant ID (a UUID).",
            "lineageTag": "6cbc568f-6c27-49a1-8cbc-568f6c27f9a1"
          },
          {
            "name": "local_date",
            "dataType": "dateTime",
            "sourceColumn": "local_date",
            "formatString": "yyyy-mm-dd",
            "summarizeBy": "none",
            "description": "Day in the report time zone.",
            "lineageTag": "a6cd2b1d-fd23-483f-86cd-2b1dfd23e83f"
          },
          {
            "name": "date_key",
            "dataType": "int64",
            "sourceColumn": "date_key",
            "summarizeBy": "none",
            "description": "local_date as a number, YYYYMMDD, for tools that filter dates numerically.",
            "lineageTag": "b7b1640d-f7a6-438f-87b1-640df7a6138f"
          },
          {
            "name": "severity_band",
            "dataType": "string",
            "sourceColumn": "severity_band",
            "summarizeBy": "none",
            "description": "Critical, High, Medium, Low or Info.",
            "lineageTag": "42604d64-1f5d-4c3a-8260-4d641f5d1c3a"
          },
          {
            "name": "severity_rank",
            "dataType": "int64",
            "sourceColumn": "severity_rank",
            "summarizeBy": "sum",
            "description": "5 Critical down to 1 Info.",
            "lineageTag": "882c5549-0d7c-450f-882c-55490d7c450f"
          },
          {
            "name": "detector_id",
            "dataType": "string",
            "sourceColumn": "detector_id",
            "summarizeBy": "none",
            "description": "Detector ID.",
            "lineageTag": "a9d00831-139f-4d3f-89d0-0831139fcd3f"
          },
          {
            "name": "detections",
            "dataType": "int64",
            "sourceColumn": "detections",
            "summarizeBy": "sum",
            "description": "Detections created that day.",
            "lineageTag": "7f944611-5f30-4743-8f94-46115f30a743"
          },
          {
            "name": "open_detections",
            "dataType": "int64",
            "sourceColumn": "open_detections",
            "summarizeBy": "sum",
            "description": "Of those, detections still OPEN at export time.",
            "lineageTag": "f43cc236-f606-4688-843c-c236f6069688"
          },
          {
            "name": "detector_name",
            "dataType": "string",
            "sourceColumn": "detector_name",
            "summarizeBy": "none",
            "description": "Detector name, repeated here for tools that can't join to dim_detector.",
            "lineageTag": "b4ab7b37-5a12-4be1-84ab-7b375a12bbe1"
          }
        ],
        "partitions": [
          {
            "name": "fact_detection_daily",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = FusionTable(\"fact_detection_daily.csv\", {{\"tenant_id\", \"text\"}, {\"local_date\", \"date\"}, {\"date_key\", \"integer\"}, {\"severity_band\", \"text\"}, {\"severity_rank\", \"integer\"}, {\"detector_id\", \"text\"}, {\"detections\", \"integer\"}, {\"open_detections\", \"integer\"}, {\"detector_name\", \"text\"}})",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total detections",
            "expression": "SUM(fact_detection_daily[detections]) + 0",
            "formatString": "#,0",
            "description": "Detections created in the selected dates (daily counts, kept past detail retention).",
            "lineageTag": "f0888215-2c3e-4a27-8088-82152c3e1a27"
          },
          {
            "name": "High and critical detections",
            "expression": "CALCULATE(SUM(fact_detection_daily[detections]), fact_detection_daily[severity_rank] >= 4) + 0",
            "formatString": "#,0",
            "description": "Detections with severity 0.6 and up.",
            "lineageTag": "1cacf311-e879-492b-8cac-f311e879992b"
          },
          {
            "name": "Open detections",
            "expression": "SUM(fact_detection_daily[open_detections]) + 0",
            "formatString": "#,0",
            "description": "Detections from the selected dates still OPEN at the last export.",
            "lineageTag": "b6d748e1-ca20-49df-86d7-48e1ca2099df"
          }
        ]
      },
