            "dataType": "string",
            "sourceColumn": "products",
            "summarizeBy": "none",
            "description": "Installed product codes joined with |.",
            "lineageTag": "2afc98fc-f0a6-475e-8afc-98fcf0a6775e"
          },
          {
            "name": "ipv4_addresses",
