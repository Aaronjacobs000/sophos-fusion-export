      {
        "name": "fact_ai_activity_daily",
        "description": "AI Defense activity counts by day, application, action and risk. Kept after activity detail is pruned.",
        "lineageTag": "aa2a9e74-2e23-4262-8a2a-9e742e238262",
        "columns": [
          {
            "name": "tenant_id",
            "dataType": "string",
            "sourceColumn": "tenant_id",
            "summarizeBy": "none",
            "isHidden": false,
            "description": "Sophos Central tenant ID (a UUID).",
            "lineageTag": "c706e53e-5dca-4928-8706-e53e5dca5928"
          },
          {
            "name": "local_date",
            "dataType": "dateTime",
            "sourceColumn": "local_date",
            "formatString": "yyyy-mm-dd",
            "summarizeBy": "none",
            "description": "Day in the report time zone.",
            "lineageTag": "8b1bac0a-4ee3-4e40-8b1b-ac0a4ee33e40"
          },
          {
            "name": "date_key",
            "dataType": "int64",
            "sourceColumn": "date_key",
            "summarizeBy": "none",
            "description": "local_date as a number, YYYYMMDD.",
            "lineageTag": "7d2c3846-43fd-416c-8d2c-384643fd016c"
          },
          {
            "name": "application_id",
            "dataType": "string",
            "sourceColumn": "application_id",
            "summarizeBy": "none",
            "description": "AI application ID (dim_ai_app).",
            "lineageTag": "57ac2574-457a-48fe-87ac-2574457a78fe"
          },
          {
            "name": "action",
            "dataType": "string",
            "sourceColumn": "action",
            "summarizeBy": "none",
            "description": "ALLOWED, BLOCKED, WARNED, MODIFIED, UNKNOWN, or empty when none was reported.",
            "lineageTag": "e77e0024-9899-42e6-877e-00249899b2e6"
          },
          {
            "name": "risk",
            "dataType": "string",
            "sourceColumn": "risk",
            "summarizeBy": "none",
            "description": "Activity risk.",
            "lineageTag": "a45f7bd5-8abc-46e7-845f-7bd58abc16e7"
          },
          {
            "name": "risk_rank",
            "dataType": "int64",
            "sourceColumn": "risk_rank",
            "summarizeBy": "sum",
            "description": "5 CRITICAL down to 1 INFO, 0 otherwise.",
            "lineageTag": "52f79618-994d-45ee-82f7-9618994d45ee"
          },
          {
            "name": "activities",
            "dataType": "int64",
            "sourceColumn": "activities",
            "summarizeBy": "sum",
            "description": "Activities that started that day.",
            "lineageTag": "2044c233-55fe-43d9-8044-c23355fe83d9"
          },
          {
            "name": "records",
            "dataType": "int64",
            "sourceColumn": "records",
            "summarizeBy": "sum",
            "description": "Telemetry records in those activities.",
            "lineageTag": "36b6cd18-87f7-4746-86b6-cd1887f74746"
          },
          {
            "name": "unsanctioned_activities",
            "dataType": "int64",
            "sourceColumn": "unsanctioned_activities",
            "summarizeBy": "sum",
            "description": "Of the activities, those allowed for an app no policy covers.",
            "lineageTag": "27152573-7566-4155-8715-257375664155"
          },
          {
            "name": "application_name",
            "dataType": "string",
            "sourceColumn": "application_name",
            "summarizeBy": "none",
            "description": "Application name, repeated for tools that can't join to dim_ai_app.",
            "lineageTag": "d92f2c9a-b06f-4b78-892f-2c9ab06fcb78"
          }
        ],
        "partitions": [
          {
            "name": "fact_ai_activity_daily",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = FusionTable(\"fact_ai_activity_daily.csv\", {{\"tenant_id\", \"text\"}, {\"local_date\", \"date\"}, {\"date_key\", \"integer\"}, {\"application_id\", \"text\"}, {\"action\", \"text\"}, {\"risk\", \"text\"}, {\"risk_rank\", \"integer\"}, {\"activities\", \"integer\"}, {\"records\", \"integer\"}, {\"unsanctioned_activities\", \"integer\"}, {\"application_name\", \"text\"}})",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "AI activities",
            "expression": "SUM(fact_ai_activity_daily[activities]) + 0",
            "formatString": "#,0",
            "description": "AI Defense activities that started in the selected dates (daily counts, kept past detail retention).",
            "lineageTag": "56757f7b-1dde-477d-8675-7f7b1dde277d"
          },
          {
            "name": "Blocked AI activities",
            "expression": "CALCULATE(SUM(fact_ai_activity_daily[activities]), fact_ai_activity_daily[action] = \"BLOCKED\") + 0",
            "formatString": "#,0",
            "description": "Activities an AI Defense policy blocked.",
            "lineageTag": "c1fc87b3-438c-499d-81fc-87b3438c099d"
          },
          {
            "name": "Warned AI activities",
            "expression": "CALCULATE(SUM(fact_ai_activity_daily[activities]), fact_ai_activity_daily[action] = \"WARNED\") + 0",
            "formatString": "#,0",
            "description": "Activities an AI Defense policy warned on.",
            "lineageTag": "05b2547e-d0b6-4884-85b2-547ed0b63884"
          },
          {
            "name": "Unsanctioned AI activities",
            "expression": "SUM(fact_ai_activity_daily[unsanctioned_activities]) + 0",
            "formatString": "#,0",
            "description": "Activities allowed for AI apps no policy covers.",
            "lineageTag": "af96293c-5a33-42f6-8f96-293c5a3362f6"
          }
        ]
      },
      {
        "name": "dim_ai_app",
        "description": "AI applications seen in activity or the inventory, with the sanctioning status the tenant's policies give each one now.",
        "lineageTag": "9fdf3964-3ba8-4cd2-8fdf-39643ba81cd2",
        "columns": [
          {
            "name": "tenant_id",
            "dataType": "string",
            "sourceColumn": "tenant_id",
            "summarizeBy": "none",
            "isHidden": false,
            "description": "Sophos Central tenant ID (a UUID).",
            "lineageTag": "ac2e954e-5afb-42b8-8c2e-954e5afb22b8"
          },
          {
            "name": "application_id",
            "dataType": "string",
            "sourceColumn": "application_id",
            "summarizeBy": "none",
            "description": "AI application ID.",
            "lineageTag": "17c4e144-694e-404e-87c4-e144694ef04e"
