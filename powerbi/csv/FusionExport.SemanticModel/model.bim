      {
        "name": "Date",
        "description": "Calendar from the first month with data to today, in the report time zone.",
        "lineageTag": "3b527379-e4b6-497f-8b52-7379e4b6097f",
        "dataCategory": "Time",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "formatString": "yyyy-mm-dd",
            "isKey": true,
            "summarizeBy": "none",
            "lineageTag": "cbea9049-f19e-463b-8bea-9049f19eb63b"
          },
          {
            "name": "Year",
            "dataType": "int64",
            "sourceColumn": "Year",
            "summarizeBy": "none",
            "lineageTag": "0672ccac-3fe2-46ce-8672-ccac3fe2d6ce"
          },
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month",
            "summarizeBy": "none",
            "sortByColumn": "Month start",
            "lineageTag": "fca18f55-bbef-4d2b-8ca1-8f55bbef7d2b"
          },
          {
            "name": "Month start",
            "dataType": "dateTime",
            "sourceColumn": "Month start",
            "formatString": "yyyy-mm-dd",
            "summarizeBy": "none",
            "lineageTag": "dbf71c45-a46a-4f1b-8bf7-1c45a46a2f1b"
          },
          {
            "name": "Week start",
            "dataType": "dateTime",
            "sourceColumn": "Week start",
            "formatString": "yyyy-mm-dd",
            "summarizeBy": "none",
            "lineageTag": "eb2eba1d-f67f-4027-8b2e-ba1df67f1027"
          }
        ],
        "partitions": [
          {
            "name": "Date",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Today = Date.From(DateTime.LocalNow()),",
                "    Seen = List.RemoveNulls(List.Combine({fact_detection_daily[local_date], fact_case[created_local_date], fact_alert[raised_local_date], fact_endpoint_snapshot[snapshot_date], fact_ai_activity_daily[local_date]})),",
                "    Start = Date.StartOfMonth(if List.IsEmpty(Seen) then Date.AddDays(Today, -90) else List.Min(Seen)),",
                "    End = Today,",
                "    Days = List.Dates(Start, Duration.Days(End - Start) + 1, #duration(1, 0, 0, 0)),",
                "    Base = Table.FromList(Days, Splitter.SplitByNothing(), type table [Date = date]),",
                "    WithYear = Table.AddColumn(Base, \"Year\", each Date.Year([Date]), Int64.Type),",
                "    WithMonth = Table.AddColumn(WithYear, \"Month\", each Date.ToText([Date], [Format = \"yyyy-MM\", Culture = \"en-US\"]), type text),",
                "    WithMonthStart = Table.AddColumn(WithMonth, \"Month start\", each Date.StartOfMonth([Date]), type date),",
                "    WithWeekStart = Table.AddColumn(WithMonthStart, \"Week start\", each Date.StartOfWeek([Date], Day.Monday), type date)",
                "in",
                "    WithWeekStart"
              ]
            }
          }
        ],
        "measures": []
      }
    ],
