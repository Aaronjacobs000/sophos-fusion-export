          }
        ],
        "partitions": [
          {
            "name": "fact_alert",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = FusionTable(\"fact_alert.csv\", {{\"tenant_id\", \"text\"}, {\"alert_id\", \"text\"}, {\"raised_at\", \"datetime\"}, {\"raised_local_date\", \"date\"}, {\"raised_date_key\", \"integer\"}, {\"severity\", \"text\"}, {\"category\", \"text\"}, {\"product\", \"text\"}, {\"alert_type\", \"text\"}, {\"status\", \"text\"}, {\"managed_agent_id\", \"text\"}, {\"managed_agent_type\", \"text\"}, {\"event_count\", \"integer\"}, {\"description\", \"text\"}, {\"last_seen_open_at\", \"datetime\"}})",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Alerts",
            "expression": "COUNTROWS(fact_alert) + 0",
            "formatString": "0",
            "description": "Product alerts raised in the selected dates.",
            "lineageTag": "b8047591-bc63-49eb-8804-7591bc63c9eb"
          },
          {
            "name": "High alerts",
            "expression": "CALCULATE(COUNTROWS(fact_alert), fact_alert[severity] = \"high\") + 0",
            "formatString": "0",
            "description": "High severity product alerts raised in the selected dates.",
            "lineageTag": "bef01875-7a8a-4dc3-8ef0-18757a8afdc3"
          }
        ]
      },
      {
        "name": "fact_ai_defense_snapshot",
        "description": "Sophos AI Defense status and Sophos's own inventory totals, one snapshot a day. The totals cover the inventory window (aiDefense.inventoryDays) ending at the export.",
        "lineageTag": "2696efce-555f-4d70-8696-efce555f9d70",
        "columns": [
          {
            "name": "tenant_id",
            "dataType": "string",
