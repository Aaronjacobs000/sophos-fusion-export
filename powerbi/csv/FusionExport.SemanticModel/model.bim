            "description": "Sophos Central tenant ID (a UUID).",
            "lineageTag": "de2ecd8c-ccab-48b2-8e2e-cd8cccabd8b2"
          },
          {
            "name": "tenant_name",
            "dataType": "string",
            "sourceColumn": "tenant_name",
            "summarizeBy": "none",
            "description": "Display name: the configured tenantName, else the name Sophos returns on alerts, else the tenant ID.",
            "lineageTag": "8ac61b62-2ea4-479c-8ac6-1b622ea4479c"
          },
          {
            "name": "fusion_tenant_id",
            "dataType": "string",
            "sourceColumn": "fusion_tenant_id",
            "summarizeBy": "none",
            "description": "The tenant's ID in Sophos Fusion GraphQL, as cases report it. Empty for a Classic tenant.",
            "lineageTag": "9d5cbc33-0f02-4b01-8d5c-bc330f02cb01"
