          },
          {
            "name": "data_region",
            "dataType": "string",
            "sourceColumn": "data_region",
            "summarizeBy": "none",
            "description": "Sophos Central data region host, for example https://api-eu01.central.sophos.com.",
            "lineageTag": "098f86d9-6cdb-45e7-898f-86d96cdb65e7"
