{
  "compatibilityLevel": 1567,
  "model": {
    "name": "FusionExport",
    "description": "Unofficial Sophos Fusion Data Exporter: the CSV tables from a SharePoint or OneDrive folder. Not a Sophos product.",
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "queryGroups": [
      {
        "folder": "Parameters"
      },
      {
        "folder": "Helpers"
      }
    ],
    "expressions": [
      {
        "name": "SharePointSiteUrl",
        "kind": "m",
        "expression": "\"https://contoso.sharepoint.com/sites/reporting\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]",
        "description": "The SharePoint site (or OneDrive for Business URL) that holds the exporter's CSV folder, for example https://contoso.sharepoint.com/sites/reporting.",
        "lineageTag": "43423f65-e558-49cf-8342-3f65e55819cf",
        "queryGroup": "Parameters",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ]
      },
      {
        "name": "ExportFolder",
        "kind": "m",
        "expression": "\"FusionExport\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]",
        "description": "The folder path inside the site's Documents library, as the exporter's sharepoint.folder setting names it, for example FusionExport/acme.",
        "lineageTag": "4ac3b76a-3ac4-4694-8ac3-b76a3ac40694",
        "queryGroup": "Parameters",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ]
      },
      {
        "name": "FusionFiles",
        "kind": "m",
        "description": "The CSV files in the export folder. Every table reads its file from here.",
        "lineageTag": "d428d638-e586-4452-8428-d638e586c452",
        "queryGroup": "Helpers",
        "expression": [
          "let",
          "    Files = SharePoint.Files(SharePointSiteUrl, [ApiVersion = 15]),",
          "    Folder = \"/\" & Text.Trim(ExportFolder, \"/\") & \"/\",",
          "    InFolder = Table.SelectRows(Files, each Text.EndsWith([Folder Path], Folder) and Text.EndsWith([Name], \".csv\"))",
          "in",
          "    InFolder"
        ]
      },
      {
        "name": "FusionTable",
        "kind": "m",
        "description": "Reads one exporter CSV with its schema types: empty cells become null, UTC timestamps become date/time values, and missing columns read as null.",
        "lineageTag": "3d16b977-03c1-45a5-8d16-b97703c165a5",
        "queryGroup": "Helpers",
        "expression": [
          "(fileName as text, columns as list) as table =>",
          "let",
          "    Match = Table.SelectRows(FusionFiles, each [Name] = fileName),",
          "    Content = if Table.RowCount(Match) = 1 then Match{0}[Content] else error Error.Record(\"Fusion Export\", fileName & \" was not found in the export folder, or found more than once.\", Table.RowCount(Match)),",
          "    Csv = Csv.Document(Content, [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
          "    Promoted = Table.PromoteHeaders(Csv, [PromoteAllScalars = true]),",
          "    Names = List.Transform(columns, each _{0}),",
          "    Selected = Table.SelectColumns(Promoted, Names, MissingField.UseNull),",
          "    Blanked = Table.ReplaceValue(Selected, \"\", null, Replacer.ReplaceValue, Names),",
          "    TypeOf = [text = type text, integer = Int64.Type, number = type number, boolean = type logical, date = type date, datetime = type datetimezone],",
          "    Typed = Table.TransformColumnTypes(Blanked, List.Transform(columns, each {_{0}, Record.Field(TypeOf, _{1})}), \"en-US\"),",
          "    Zoned = List.Select(columns, each _{1} = \"datetime\"),",
          "    Utc = Table.TransformColumns(Typed, List.Transform(Zoned, each {_{0}, DateTimeZone.RemoveZone, type datetime}))",
          "in",
          "    Utc"
        ]
      }
    ],
    "tables": [
      {
        "name": "dim_tenant",
        "description": "The tenant this credential reads. One row per tenant.",
        "lineageTag": "a1959b7a-3df3-47e4-8195-9b7a3df347e4",
        "columns": [
