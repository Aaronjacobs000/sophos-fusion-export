            "summarizeBy": "sum",
            "description": "Current usage count Sophos reports. Empty when it sends none.",
            "lineageTag": "ac442a8e-bffb-47fc-8c44-2a8ebffb07fc"
          },
          {
            "name": "unlimited",
            "dataType": "boolean",
            "sourceColumn": "unlimited",
            "summarizeBy": "none",
            "description": "True for an unlimited license.",
            "lineageTag": "deb71fca-f457-4264-8eb7-1fcaf457d264"
          },
          {
            "name": "perpetual",
            "dataType": "boolean",
            "sourceColumn": "perpetual",
            "summarizeBy": "none",
            "description": "True for a perpetual license.",
            "lineageTag": "ae5b035f-2740-4f49-8e5b-035f2740cf49"
          },
          {
            "name": "start_date",
            "dataType": "dateTime",
            "sourceColumn": "start_date",
            "formatString": "yyyy-mm-dd",
            "summarizeBy": "none",
            "description": "License start date.",
            "lineageTag": "4e0baed2-60db-4ad0-8e0b-aed260db6ad0"
          },
          {
            "name": "end_date",
            "dataType": "dateTime",
            "sourceColumn": "end_date",
            "formatString": "yyyy-mm-dd",
            "summarizeBy": "none",
            "description": "License end date. Empty for a perpetual license.",
            "lineageTag": "4d77dd1d-3209-44af-8d77-dd1d320924af"
          },
          {
            "name": "days_to_end",
            "dataType": "int64",
            "sourceColumn": "days_to_end",
            "summarizeBy": "sum",
            "description": "Days from the snapshot date to the end date. Negative once expired.",
            "lineageTag": "273b79be-32df-49c0-873b-79be32dfe9c0"
          }
        ],
        "partitions": [
          {
            "name": "fact_license",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = FusionTable(\"fact_license.csv\", {{\"tenant_id\", \"text\"}, {\"snapshot_date\", \"date\"}, {\"license_id\", \"text\"}, {\"license_code\", \"text\"}, {\"generic_code\", \"text\"}, {\"product_name\", \"text\"}, {\"license_type\", \"text\"}, {\"quantity\", \"integer\"}, {\"used\", \"integer\"}, {\"unlimited\", \"boolean\"}, {\"perpetual\", \"boolean\"}, {\"start_date\", \"date\"}, {\"end_date\", \"date\"}, {\"days_to_end\", \"integer\"}})",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Licensed quantity",
            "expression": "VAR LatestSnapshot = MAX(fact_license[snapshot_date])\nRETURN CALCULATE(SUM(fact_license[quantity]), fact_license[snapshot_date] = LatestSnapshot)",
            "formatString": "#,0",
            "description": "Licensed quantity in the latest snapshot. Unlimited licenses have none.",
            "lineageTag": "3f32afa1-d73c-487f-8f32-afa1d73c187f"
          },
          {
            "name": "Licenses used",
            "expression": "VAR LatestSnapshot = MAX(fact_license[snapshot_date])\nRETURN CALCULATE(SUM(fact_license[used]), fact_license[snapshot_date] = LatestSnapshot)",
            "formatString": "#,0",
            "description": "Usage Sophos reports, latest snapshot.",
            "lineageTag": "273d5562-86a2-43a4-873d-556286a2c3a4"
          }
        ]
      },
