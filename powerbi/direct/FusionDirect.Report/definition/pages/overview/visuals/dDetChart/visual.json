{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "dDetChart",
  "position": {
    "x": 16,
    "y": 168,
    "z": 6000,
    "width": 824,
    "height": 264,
    "tabOrder": 6000
  },
  "visual": {
    "visualType": "columnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Date"
                    }
                  },
                  "Property": "Date"
                }
              },
              "queryRef": "Date.Date",
              "nativeQueryRef": "Date"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_detection"
                    }
                  },
                  "Property": "severity_band"
                }
              },
              "queryRef": "fact_detection.severity_band",
              "nativeQueryRef": "severity_band",
              "displayName": "Severity"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_detection"
                    }
                  },
                  "Property": "Detection rows"
                }
              },
              "queryRef": "fact_detection.Detection rows",
              "nativeQueryRef": "Detection rows"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Detections per day by severity'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
