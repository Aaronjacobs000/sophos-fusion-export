          },
          {
            "name": "snapshot_date",
            "dataType": "dateTime",
            "sourceColumn": "snapshot_date",
            "formatString": "yyyy-mm-dd",
            "summarizeBy": "none",
            "description": "Day of the snapshot in the report time zone.",
            "lineageTag": "d9144455-ac1c-473b-8914-4455ac1cc73b"
          },
          {
            "name": "endpoint_id",
            "dataType": "string",
            "sourceColumn": "endpoint_id",
            "summarizeBy": "none",
            "description": "Endpoint ID. Equals host_id in the Sophos Data Lake.",
            "lineageTag": "3767090f-a978-4a31-8767-090fa9785a31"
          },
          {
            "name": "endpoint_type",
            "dataType": "string",
            "sourceColumn": "endpoint_type",
            "summarizeBy": "none",
            "description": "computer, server or securityVm.",
            "lineageTag": "766bac52-3f88-4d6c-866b-ac523f889d6c"
          },
          {
