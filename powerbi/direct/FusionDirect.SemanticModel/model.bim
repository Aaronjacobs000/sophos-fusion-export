          },
          {
            "name": "os_name",
            "dataType": "string",
            "sourceColumn": "os_name",
            "summarizeBy": "none",
            "description": "Operating system name.",
            "lineageTag": "44266ab4-c4d7-41ba-8426-6ab4c4d741ba"
          },
          {
            "name": "health_overall",
            "dataType": "string",
            "sourceColumn": "health_overall",
            "summarizeBy": "none",
            "description": "good, suspicious, bad or unknown.",
            "lineageTag": "87e5d358-c911-47aa-87e5-d358c91147aa"
          },
          {
            "name": "last_seen_at",
            "dataType": "dateTime",
            "sourceColumn": "last_seen_at",
            "formatString": "yyyy-mm-dd hh:nn:ss",
            "summarizeBy": "none",
            "description": "When the endpoint last checked in.",
            "lineageTag": "c9726eba-8eab-4ed0-8972-6eba8eab5ed0"
          },
          {
            "name": "days_since_seen",
            "dataType": "double",
            "sourceColumn": "days_since_seen",
            "summarizeBy": "sum",
            "description": "Days from last_seen_at to the snapshot time.",
            "lineageTag": "e7412b98-86ce-40de-8741-2b9886ce80de"
          },
          {
            "name": "tamper_protection_enabled",
            "dataType": "boolean",
            "sourceColumn": "tamper_protection_enabled",
            "summarizeBy": "none",
            "description": "Tamper protection on.",
            "lineageTag": "37245943-04d9-4ded-8724-594304d91ded"
          },
          {
            "name": "isolation_status",
            "dataType": "string",
            "sourceColumn": "isolation_status",
            "summarizeBy": "none",
            "description": "isolated or notIsolated.",
            "lineageTag": "3b017cdf-e98f-4b15-8b01-7cdfe98f8b15"
          },
          {
            "name": "group_name",
            "dataType": "string",
            "sourceColumn": "group_name",
            "summarizeBy": "none",
            "description": "Endpoint group.",
            "lineageTag": "2c934867-2def-40e5-8c93-48672def70e5"
          }
        ],
        "partitions": [
          {
            "name": "fact_endpoint_snapshot",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Get = (r, path as list) => List.Accumulate(path, r, (s, k) => if s = null then null else if Value.Is(s, type record) then Record.FieldOrDefault(s, k, null) else null),\n    Iso = (t) => if t = null then null else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(t), 0)),\n    Epoch = (s) => if s = null then null else #datetime(1970, 1, 1, 0, 0, 0) + #duration(0, 0, 0, s),",
                "    Fetch = (key) => SophosGet(\"endpoint/v1/endpoints\", if key = null then [pageSize = \"500\"] else [pageSize = \"500\", pageFromKey = key]),",
                "    Pages = List.Generate(() => [p = Fetch(null), n = 1], each [p] <> null, each let next = Get([p], {\"pages\", \"nextKey\"}) in if next <> null and [n] < 200 then [p = Fetch(next), n = [n] + 1] else [p = null, n = [n]], each Get([p], {\"items\"})),",
                "    Now = DateTimeZone.RemoveZone(DateTimeZone.UtcNow()),",
                "    Rows = List.Transform(List.Combine(List.RemoveNulls(Pages)), (e) => [",
                "        tenant_id = SophosTenantId,",
                "        snapshot_date = Date.From(Now),",
                "        endpoint_id = e[id],",
                "        endpoint_type = Get(e, {\"type\"}),",
                "        os_platform = Get(e, {\"os\", \"platform\"}),",
                "        os_name = let n = Get(e, {\"os\", \"name\"}) in if n = null then null else Text.Trim(n),",
                "        health_overall = Get(e, {\"health\", \"overall\"}),",
                "        last_seen_at = Iso(Get(e, {\"lastSeenAt\"})),",
                "        days_since_seen = if last_seen_at = null then null else Number.Round(Duration.TotalDays(Now - last_seen_at), 2),",
                "        tamper_protection_enabled = Get(e, {\"tamperProtectionEnabled\"}),",
                "        isolation_status = Get(e, {\"isolation\", \"status\"}),",
                "        group_name = Get(e, {\"group\", \"name\"})",
                "    ]),",
                "    Table = Table.FromRecords(Rows, {\"tenant_id\", \"snapshot_date\", \"endpoint_id\", \"endpoint_type\", \"os_platform\", \"os_name\", \"health_overall\", \"last_seen_at\", \"days_since_seen\", \"tamper_protection_enabled\", \"isolation_status\", \"group_name\"}, MissingField.UseNull),",
                "    Typed = Table.TransformColumnTypes(Table, {{\"tenant_id\", type text}, {\"snapshot_date\", type date}, {\"endpoint_id\", type text}, {\"endpoint_type\", type text}, {\"os_platform\", type text}, {\"os_name\", type text}, {\"health_overall\", type text}, {\"last_seen_at\", type datetime}, {\"days_since_seen\", type number}, {\"tamper_protection_enabled\", type logical}, {\"isolation_status\", type text}, {\"group_name\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Endpoints",
            "expression": "VAR LatestSnapshot = MAX(fact_endpoint_snapshot[snapshot_date])\nRETURN CALCULATE(COUNTROWS(fact_endpoint_snapshot), fact_endpoint_snapshot[snapshot_date] = LatestSnapshot) + 0",
            "formatString": "0",
            "description": "Endpoints in the latest snapshot of the selected dates.",
            "lineageTag": "cc08888c-7816-491a-8c08-888c7816291a"
          },
          {
            "name": "Endpoints not in good health",
            "expression": "VAR LatestSnapshot = MAX(fact_endpoint_snapshot[snapshot_date])\nRETURN CALCULATE(COUNTROWS(fact_endpoint_snapshot), fact_endpoint_snapshot[snapshot_date] = LatestSnapshot, fact_endpoint_snapshot[health_overall] <> \"good\") + 0",
            "formatString": "0",
            "description": "Latest snapshot, overall health not good.",
            "lineageTag": "80e701e5-aeff-40c7-80e7-01e5aeff10c7"
          },
          {
            "name": "Endpoints not seen 7+ days",
            "expression": "VAR LatestSnapshot = MAX(fact_endpoint_snapshot[snapshot_date])\nRETURN CALCULATE(COUNTROWS(fact_endpoint_snapshot), fact_endpoint_snapshot[snapshot_date] = LatestSnapshot, fact_endpoint_snapshot[days_since_seen] >= 7) + 0",
            "formatString": "0",
            "description": "Latest snapshot, last seen a week or more before it.",
            "lineageTag": "0e89fab1-5219-423b-8e89-fab15219e23b"
          },
          {
            "name": "Tamper protection off",
            "expression": "VAR LatestSnapshot = MAX(fact_endpoint_snapshot[snapshot_date])\nRETURN CALCULATE(COUNTROWS(fact_endpoint_snapshot), fact_endpoint_snapshot[snapshot_date] = LatestSnapshot, fact_endpoint_snapshot[tamper_protection_enabled] == FALSE()) + 0",
            "formatString": "0",
            "description": "Latest snapshot, tamper protection off.",
            "lineageTag": "041cb867-8dd8-49f1-841c-b8678dd809f1"
          }
        ]
      },
      {
        "name": "fact_alert",
