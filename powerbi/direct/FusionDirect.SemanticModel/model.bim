          }
        ],
        "partitions": [
          {
            "name": "fact_alert",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Get = (r, path as list) => List.Accumulate(path, r, (s, k) => if s = null then null else if Value.Is(s, type record) then Record.FieldOrDefault(s, k, null) else null),\n    Iso = (t) => if t = null then null else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(t), 0)),\n    Epoch = (s) => if s = null then null else #datetime(1970, 1, 1, 0, 0, 0) + #duration(0, 0, 0, s),",
                "    Fetch = (key) => SophosGet(\"common/v1/alerts\", if key = null then [pageSize = \"1000\"] else [pageSize = \"1000\", pageFromKey = key]),",
                "    Pages = List.Generate(() => [p = Fetch(null), n = 1], each [p] <> null, each let next = Get([p], {\"pages\", \"nextKey\"}) in if next <> null and [n] < 100 then [p = Fetch(next), n = [n] + 1] else [p = null, n = [n]], each Get([p], {\"items\"})),",
                "    Rows = List.Transform(List.Combine(List.RemoveNulls(Pages)), (a) => [",
                "        tenant_id = SophosTenantId,",
                "        alert_id = a[id],",
                "        raised_at = Iso(Get(a, {\"raisedAt\"})),",
                "        raised_local_date = if raised_at = null then null else Date.From(raised_at),",
                "        severity = Get(a, {\"severity\"}),",
                "        category = Get(a, {\"category\"}),",
                "        product = Get(a, {\"product\"}),",
                "        alert_type = Get(a, {\"type\"})",
                "    ]),",
                "    Table = Table.FromRecords(Rows, {\"tenant_id\", \"alert_id\", \"raised_at\", \"raised_local_date\", \"severity\", \"category\", \"product\", \"alert_type\"}, MissingField.UseNull),",
                "    Typed = Table.TransformColumnTypes(Table, {{\"tenant_id\", type text}, {\"alert_id\", type text}, {\"raised_at\", type datetime}, {\"raised_local_date\", type date}, {\"severity\", type text}, {\"category\", type text}, {\"product\", type text}, {\"alert_type\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Alerts",
            "expression": "COUNTROWS(fact_alert) + 0",
            "formatString": "0",
            "description": "Product alerts raised in the selected dates.",
            "lineageTag": "b8047591-bc63-49eb-8804-7591bc63c9eb"
          },
          {
            "name": "High alerts",
            "expression": "CALCULATE(COUNTROWS(fact_alert), fact_alert[severity] = \"high\") + 0",
            "formatString": "0",
            "description": "High severity product alerts raised in the selected dates.",
            "lineageTag": "bef01875-7a8a-4dc3-8ef0-18757a8afdc3"
          }
        ]
      },
      {
        "name": "fact_license",
        "description": "Licenses held by the tenant, one snapshot a day. Read live by Power Query (direct path).",
        "lineageTag": "966ffbe0-49ac-455a-866f-fbe049ac055a",
        "columns": [
          {
            "name": "tenant_id",
            "dataType": "string",
            "sourceColumn": "tenant_id",
            "summarizeBy": "none",
            "isHidden": false,
            "description": "Sophos Central tenant ID (a UUID).",
            "lineageTag": "6b0a99d5-d863-48b3-8b0a-99d5d86348b3"
          },
          {
            "name": "snapshot_date",
            "dataType": "dateTime",
            "sourceColumn": "snapshot_date",
            "formatString": "yyyy-mm-dd",
            "summarizeBy": "none",
            "description": "Day of the snapshot in the report time zone.",
            "lineageTag": "3d193564-2018-486a-8d19-35642018786a"
          },
          {
            "name": "license_id",
            "dataType": "string",
            "sourceColumn": "license_id",
            "summarizeBy": "none",
            "description": "Sophos license record ID.",
            "lineageTag": "5218b9de-246b-4cb4-8218-b9de246b3cb4"
          },
          {
            "name": "license_code",
            "dataType": "string",
            "sourceColumn": "license_code",
            "summarizeBy": "none",
            "description": "License code, for example XDR-MSP or CIXAXDR.",
            "lineageTag": "bdc40b8a-9bf4-41c0-8dc4-0b8a9bf421c0"
          },
          {
            "name": "product_name",
            "dataType": "string",
            "sourceColumn": "product_name",
            "summarizeBy": "none",
            "description": "Product name Sophos gives the license.",
            "lineageTag": "10e51f00-24ca-46ba-80e5-1f0024caf6ba"
          },
          {
            "name": "license_type",
            "dataType": "string",
            "sourceColumn": "license_type",
            "summarizeBy": "none",
            "description": "term, trial, usage (MSP monthly) or another value Sophos sends.",
            "lineageTag": "ce5ca9eb-98ff-4ba9-8e5c-a9eb98ff7ba9"
          },
          {
            "name": "quantity",
            "dataType": "int64",
            "sourceColumn": "quantity",
            "summarizeBy": "sum",
            "description": "Licensed quantity. Empty when unlimited.",
            "lineageTag": "3aef8b06-1fc0-4e3c-8aef-8b061fc03e3c"
          },
          {
            "name": "used",
            "dataType": "int64",
            "sourceColumn": "used",
            "summarizeBy": "sum",
            "description": "Current usage count Sophos reports. Empty when it sends none.",
            "lineageTag": "ac442a8e-bffb-47fc-8c44-2a8ebffb07fc"
          },
          {
            "name": "end_date",
            "dataType": "dateTime",
            "sourceColumn": "end_date",
            "formatString": "yyyy-mm-dd",
            "summarizeBy": "none",
            "description": "License end date. Empty for a perpetual license.",
            "lineageTag": "4d77dd1d-3209-44af-8d77-dd1d320924af"
          }
        ],
        "partitions": [
          {
            "name": "fact_license",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Get = (r, path as list) => List.Accumulate(path, r, (s, k) => if s = null then null else if Value.Is(s, type record) then Record.FieldOrDefault(s, k, null) else null),\n    Iso = (t) => if t = null then null else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(t), 0)),\n    Epoch = (s) => if s = null then null else #datetime(1970, 1, 1, 0, 0, 0) + #duration(0, 0, 0, s),",
                "    Body = Json.Document(Web.Contents(\"https://api.central.sophos.com\", [RelativePath = \"licenses/v1/licenses\", Headers = [Authorization = \"Bearer \" & SophosToken, #\"X-Tenant-ID\" = SophosTenantId]])),",
                "    Today = Date.From(DateTimeZone.UtcNow()),",
                "    Rows = List.Transform(List.Select(if Get(Body, {\"licenses\"}) = null then {} else Body[licenses], each Get(_, {\"product\", \"code\"}) <> null), (l) => [",
                "        tenant_id = SophosTenantId,",
                "        snapshot_date = Today,",
                "        license_id = Get(l, {\"id\"}),",
                "        license_code = Get(l, {\"product\", \"code\"}),",
                "        product_name = Get(l, {\"product\", \"name\"}),",
                "        license_type = Get(l, {\"type\"}),",
                "        quantity = if Get(l, {\"unlimited\"}) = true then null else Get(l, {\"quantity\"}),",
                "        used = Get(l, {\"usage\", \"current\", \"count\"}),",
                "        end_date = let d = Get(l, {\"endDate\"}) in if d = null or Get(l, {\"perpetual\"}) = true then null else Date.FromText(d, [Format = \"yyyy-MM-dd\"])",
                "    ]),",
                "    Table = Table.FromRecords(Rows, {\"tenant_id\", \"snapshot_date\", \"license_id\", \"license_code\", \"product_name\", \"license_type\", \"quantity\", \"used\", \"end_date\"}, MissingField.UseNull),",
                "    Typed = Table.TransformColumnTypes(Table, {{\"tenant_id\", type text}, {\"snapshot_date\", type date}, {\"license_id\", type text}, {\"license_code\", type text}, {\"product_name\", type text}, {\"license_type\", type text}, {\"quantity\", Int64.Type}, {\"used\", Int64.Type}, {\"end_date\", type date}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Licensed quantity",
            "expression": "VAR LatestSnapshot = MAX(fact_license[snapshot_date])\nRETURN CALCULATE(SUM(fact_license[quantity]), fact_license[snapshot_date] = LatestSnapshot)",
            "formatString": "#,0",
            "description": "Licensed quantity in the latest snapshot. Unlimited licenses have none.",
            "lineageTag": "3f32afa1-d73c-487f-8f32-afa1d73c187f"
          },
          {
            "name": "Licenses used",
            "expression": "VAR LatestSnapshot = MAX(fact_license[snapshot_date])\nRETURN CALCULATE(SUM(fact_license[used]), fact_license[snapshot_date] = LatestSnapshot)",
            "formatString": "#,0",
            "description": "Usage Sophos reports, latest snapshot.",
